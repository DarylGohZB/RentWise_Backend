# Test Environment Variables
NODE_ENV=test

# Database (Mocked in tests)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=testpass
DB_NAME=rentwiseDB_test

# JWT Secrets
JWT_SECRET=test_jwt_secret_key_for_testing_only
JWT_REFRESH_SECRET=test_refresh_secret_key_for_testing_only
JWT_EXPIRE_TIME=1h
JWT_REFRESH_EXPIRE_TIME=7d

# Email Service (Mocked in tests)
GMAIL_USER=test@example.com
GMAIL_PASS=test_password

# Redis (Mocked in tests)
REDIS_HOST=localhost
REDIS_PORT=6379

# OneMap API (Mocked in tests)
ONEMAP_API_KEY=test_api_key

# Data.gov.sg API
DATAGOVSG_API_KEY=test_api_key

# Port
PORT=3000
